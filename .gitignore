# Node modules
node_modules/
# package-lock.json is committed so Railway installs the exact same versions

# Next.js build output
.next/
out/

# Production build
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS-specific files
.DS_Store
Thumbs.db

# Vercel deployment
.vercel/

# Optional: if using TypeScript
*.tsbuildinfo

# Optional: if using testing tools
coverage/
jest-test-results.json

# Optional: if using IDEs
.vscode/
.idea/

# Optional: if using TurboRepo or monorepo
turbo/
# Env files: real values live only on each machine / in Railway Variables.
# Copy .env.example to .env (public config) and .env.local (server secrets).
.env
.env*.local
!.env.example
