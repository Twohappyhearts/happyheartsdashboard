# Copy to .env and fill in. These two are PUBLIC (shipped to the browser):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# SERVER-ONLY secret (admin user management). Never commit; never prefix with NEXT_PUBLIC_.
# Locally put it in .env.local; on Railway add it under Variables.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# SERVER-ONLY: MinerU cloud API (https://mineru.net → API token) for parsing PDF / Word / PowerPoint.
# Without it, PDFs use the built-in text extraction (needs Node 22+) and PowerPoint/.doc can't be parsed.
MINERU_API_TOKEN=
# Optional: "vlm" (default) or "pipeline"; language hint for "pipeline", e.g. "en" or "ch".
# MINERU_MODEL_VERSION=vlm
# MINERU_LANGUAGE=en

# SERVER-ONLY: embeddings via Alibaba Cloud Model Studio (DashScope), OpenAI-compatible API.
# Beijing: https://dashscope.aliyuncs.com/compatible-mode/v1  ·  International: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# Must match the database column (knowledge_chunks.embedding vector(1024)).
EMBEDDING_DIMENSIONS=1024

# SERVER-ONLY: rerank model (uses DASHSCOPE_API_KEY). Beijing: https://dashscope.aliyuncs.com/compatible-api/v1
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
RERANK_MODEL=qwen3.7-text-rerank

# SERVER-ONLY: AI agent (Vercel AI SDK v7 + DeepSeek).
# Default: DeepSeek on Alibaba Cloud Model Studio — uses DASHSCOPE_API_KEY / DASHSCOPE_BASE_URL above.
# AGENT_PROVIDER=dashscope
# Or DeepSeek's own API: AGENT_PROVIDER=deepseek with DEEPSEEK_API_KEY (and optionally DEEPSEEK_BASE_URL).
# AGENT_BASE_URL overrides the base URL for either provider.
AGENT_MODEL=deepseek-v4.1-flash-1017
# AGENT_SUMMARY_MODEL=deepseek-v4.1-flash-1017
# AGENT_THINKING=enabled
# AGENT_MAX_STEPS=5
# Context compression. Budget is our own threshold (not the model's window), in AGENT_CONTEXT_UNIT.
#   >= AGENT_TRIM_AT × budget      → shorten old knowledge-base search results
#   >= AGENT_SUMMARIZE_AT × budget → LLM summary of older turns, keep the last AGENT_KEEP_RECENT_TURNS
# AGENT_CONTEXT_UNIT=chars
# AGENT_CONTEXT_BUDGET=40000
# AGENT_TRIM_AT=0.5
# AGENT_SUMMARIZE_AT=0.8
# AGENT_KEEP_RECENT_TURNS=4
# AGENT_RAG_KEEP_TURNS=1
# AGENT_RAG_TRIM_CHARS=200
# Signs tool-approval requests (HMAC). Generate with: openssl rand -base64 32
TOOL_APPROVAL_SECRET=
